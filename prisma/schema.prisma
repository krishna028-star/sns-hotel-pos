// SNS Hotels POS — Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Role Hierarchy Enum ──────────────────────────────────────────────
enum Role {
  main_admin
  main_client
  franchise_head
  hotel_manager
  inventory_manager
  cashier
  chef
  worker
  customer
}

// ── Multi-Tenancy (SNS Group, Royal Group, etc.) ──────────────────────
model Tenant {
  id          String   @id @default(cuid())
  name        String   @unique
  domain      String?  @unique
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
  hotels      Hotel[]
}

// ── Hotel / Branch ───────────────────────────────────────────────────
model Hotel {
  id          String   @id @default(cuid())
  name        String
  address     String?
  phoneNumber String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  tables      Table[]
  orders      Order[]
  staff       User[]   @relation("HotelStaff")
  inventory   InventoryItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── User Management ──────────────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role     @default(customer)
  avatar        String?
  isActive      Boolean  @default(true)
  
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  
  hotelId       String?
  hotel         Hotel?   @relation("HotelStaff", fields: [hotelId], references: [id])
  
  // HR & Security Details
  staffId       String?  @unique // Unique Role/Staff ID (e.g. SNS-WKR-101)
  age           Int?
  joiningDate   DateTime? @default(now())
  salary        Decimal? @db.Decimal(10, 2)
  workingDays   Int?     @default(26)
  presenceThisMonth Int? @default(0)
  remarks       String?
  
  auditLogs     AuditLog[]
  orders        Order[]  @relation("CustomerOrders")
  takenOrders   Order[]  @relation("WaiterOrders")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Restaurant Operations ────────────────────────────────────────────
model Table {
  id        String      @id @default(cuid())
  number    String
  capacity  Int
  status    TableStatus @default(free)
  hotelId   String
  hotel     Hotel       @relation(fields: [hotelId], references: [id])
  orders    Order[]
}

enum TableStatus {
  free
  occupied
  reserved
  cleaning
}

model Order {
  id          String      @id @default(cuid())
  status      OrderStatus @default(pending)
  totalAmount Decimal     @db.Decimal(10, 2)
  
  tableId     String?
  table       Table?      @relation(fields: [tableId], references: [id])
  
  hotelId     String
  hotel       Hotel       @relation(fields: [hotelId], references: [id])
  
  customerId  String?
  customer    User?       @relation("CustomerOrders", fields: [customerId], references: [id])
  
  waiterId    String?
  waiter      User?       @relation("WaiterOrders", fields: [waiterId], references: [id])
  
  items       OrderItem[]
  kots        KOT[]
  payments    Payment[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum OrderStatus {
  pending
  kot_sent
  cooking
  ready
  served
  bill_requested
  paid
  cancelled
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  name      String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  notes     String?
}

model KOT {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id])
  status    KOTStatus @default(pending)
  chefId    String?
  itemsJson String    // Stores the specific items for this runner
  createdAt DateTime  @default(now())
}

enum KOTStatus {
  pending
  cooking
  ready
  collected
}

// ── Inventory & Theft ───────────────────────────────────────────────
model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  category      String
  stockQuantity Decimal  @db.Decimal(10, 3)
  unit          String
  unitCost      Decimal  @db.Decimal(10, 2)
  reorderLevel  Decimal  @db.Decimal(10, 3)
  
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id])
  
  theftReports  TheftReport[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TheftReport {
  id          String   @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  quantity    Decimal  @db.Decimal(10, 3)
  reason      String
  evidenceUrl String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ── Financials ──────────────────────────────────────────────────────
model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        String        @default("pending") // pending, completed, failed
  transactionId String?
  createdAt     DateTime      @default(now())
}

enum PaymentMethod {
  cash
  upi
  card
  app_wallet
}

// ── System Integrity ────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  oldData   String? // JSON
  newData   String? // JSON
  ipAddress String?
  createdAt DateTime @default(now())
}
