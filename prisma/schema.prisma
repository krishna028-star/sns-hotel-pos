// SNS Hotels POS — Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Role Hierarchy Enum ──────────────────────────────────────────────
// NOTE: After adding mini_admin, run: npx prisma migrate dev --name add_mini_admin_role
enum Role {
  main_admin
  mini_admin       // Regional super-admin (BUG-17 FIX)
  main_client
  franchise_head
  hotel_manager
  inventory_manager
  cashier
  chef
  worker
  customer
}

// ── Multi-Tenancy (SNS Group, Royal Group, etc.) ──────────────────────
model Tenant {
  id          String   @id @default(cuid())
  customId    String?  @unique
  name        String   @unique
  domain      String?  @unique
  logo        String?
  plan        String?  @default("basic") // basic, professional, enterprise
  status      String?  @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
  franchises  Franchise[]
  hotels      Hotel[]
  policies    Policy[]
}

// ── Franchise (Regional Groups) ───────────────────────────────────────
model Franchise {
  id          String   @id @default(cuid())
  name        String
  revenue     Decimal? @db.Decimal(10, 2) @default(0)
  status      String   @default("active")
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  headUserId  String?
  headUser    User?    @relation("FranchiseHead", fields: [headUserId], references: [id])
  
  hotels      Hotel[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Hotel / Branch ───────────────────────────────────────────────────
model Hotel {
  id          String   @id @default(cuid())
  name        String
  address     String?
  phoneNumber String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])
  
  tables      Table[]
  orders      Order[]
  staff       User[]   @relation("HotelStaff")
  inventory   InventoryItem[]
  menuItems   MenuItem[]
  bookings    Booking[]
  purchaseOrders PurchaseOrder[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── User Management ──────────────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role     @default(customer)
  avatar        String?
  isActive      Boolean  @default(true)
  
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  
  hotelId       String?
  hotel         Hotel?   @relation("HotelStaff", fields: [hotelId], references: [id])
  
  headOfFranchise Franchise[] @relation("FranchiseHead")
  
  // HR & Security Details
  staffId       String?  @unique // Unique Role/Staff ID (e.g. SNS-WKR-101)
  age           Int?
  joiningDate   DateTime? @default(now())
  salary        Decimal? @db.Decimal(10, 2)
  workingDays   Int?     @default(26)
  presenceThisMonth Int? @default(0)
  remarks       String?
  
  auditLogs     AuditLog[]
  orders        Order[]  @relation("CustomerOrders")
  takenOrders   Order[]  @relation("WaiterOrders")
  shifts        CashierShift[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Restaurant Operations ────────────────────────────────────────────
model Table {
  id        String      @id @default(cuid())
  number    String
  floor     String?
  capacity  Int
  status    TableStatus @default(free)
  hotelId   String
  hotel     Hotel       @relation(fields: [hotelId], references: [id])
  orders    Order[]
}

enum TableStatus {
  free
  occupied
  reserved
  cleaning
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  price       Decimal  @db.Decimal(10, 2)
  category    String
  available   Boolean  @default(true)
  image       String?
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id           String      @id @default(cuid())
  status       OrderStatus @default(pending)
  totalAmount  Decimal     @db.Decimal(10, 2)
  version      Int         @default(0)
  
  tableId      String?
  table        Table?      @relation(fields: [tableId], references: [id])
  
  hotelId      String
  hotel        Hotel       @relation(fields: [hotelId], references: [id])
  
  customerId   String?
  customer     User?       @relation("CustomerOrders", fields: [customerId], references: [id])
  
  waiterId     String?
  waiter       User?       @relation("WaiterOrders", fields: [waiterId], references: [id])
  
  items        OrderItem[]
  kots         KOT[]
  payments     Payment[]
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum OrderStatus {
  pending
  kot_sent
  cooking
  ready
  served
  bill_requested
  paid
  cancelled
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  name      String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  notes     String?
}

model KOT {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id])
  status    KOTStatus @default(pending)
  chefId    String?
  itemsJson String    // Stores the specific items for this runner
  createdAt DateTime  @default(now())
}

enum KOTStatus {
  pending
  cooking
  ready
  collected
}

// ── Bookings ─────────────────────────────────────────────────────────
model Booking {
  id           String   @id @default(cuid())
  customerName String
  phoneNumber  String?
  tableNum     String?
  date         DateTime
  time         String
  guests       Int
  status       String   @default("pending") // pending, confirmed, cancelled
  preOrder     Boolean  @default(false)
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Inventory & Procurement ──────────────────────────────────────────
model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  category      String
  stockQuantity Decimal  @db.Decimal(10, 3)
  unit          String
  unitCost      Decimal  @db.Decimal(10, 2)
  reorderLevel  Decimal  @db.Decimal(10, 3)
  version       Int      @default(0)
  
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id])
  
  theftReports  TheftReport[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contact     String?
  phone       String?
  email       String?
  categories  String?
  rating      Float?
  status      String   @default("active")
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  itemsCount  Int
  amount      Decimal  @db.Decimal(10, 2)
  status      String   @default("pending_approval")
  date        DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TheftReport {
  id          String   @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  quantity    Decimal  @db.Decimal(10, 3)
  reason      String
  evidenceUrl String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ── Financials ──────────────────────────────────────────────────────
model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        String        @default("pending") // pending, completed, failed
  transactionId String?
  version       Int           @default(0)
  createdAt     DateTime      @default(now())
}

enum PaymentMethod {
  cash
  upi
  card
  app_wallet
}

model CashierShift {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  startTime      DateTime  @default(now())
  endTime        DateTime?
  startingCash   Decimal   @db.Decimal(10, 2)
  endingCash     Decimal?  @db.Decimal(10, 2)
  difference     Decimal?  @db.Decimal(10, 2)
  notes          String?
  status         String    @default("open") // open, closed
}

// ── Policies & Configuration ─────────────────────────────────────────
model Policy {
  id        String   @id @default(cuid())
  name      String
  value     String
  scope     String   @default("hotel") // hotel, franchise, tenant
  status    String   @default("active")
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── System Integrity ────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  oldData   String? // JSON
  newData   String? // JSON
  ipAddress String?
  createdAt DateTime @default(now())
}
