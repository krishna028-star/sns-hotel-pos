{
  "monitors": [
    {
      "friendly_name": "SNS Hotel POS - Production Frontend",
      "url": "https://<your-production-url>.com",
      "type": 1, 
      "interval": 300,
      "alert_contacts": ["<ALERT_CONTACT_ID_EMAIL>", "<ALERT_CONTACT_ID_SMS>"]
    },
    {
      "friendly_name": "SNS Hotel POS - Production Health Check",
      "url": "https://<your-production-url>.com/api/health",
      "type": 1,
      "interval": 300,
      "keyword_type": 2,
      "keyword_value": "\"status\":\"ok\"",
      "alert_contacts": ["<ALERT_CONTACT_ID_EMAIL>", "<ALERT_CONTACT_ID_SMS>"]
    }
  ]
}
